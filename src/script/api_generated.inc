// core.bag_tagged(player: number, tag: number) -> { number }
int l_bag_tagged(lua_State *L)
{
    VmState *vm = host_of(L);
    const int player = (int)luaL_checkinteger(L, 1);
    const int tag = (int)luaL_checkinteger(L, 2);
    int buffer[96] = {0};
    const int written = (vm && vm->host.bag_tagged) ? vm->host.bag_tagged(vm->host.ud, player, tag, buffer, 96) : 0;
    const int count = written < 0 ? 0 : (written > 96 ? 96 : written);
    lua_createtable(L, count, 0);
    for (int i = 0; i < count; ++i) {
        lua_pushinteger(L, buffer[i]);
        lua_rawseti(L, -2, i + 1);
    }
    return 1;
}

