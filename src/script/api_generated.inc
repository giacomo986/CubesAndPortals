    const float y = (float)luaL_checknumber(L, 2);
    const float z = (float)luaL_checknumber(L, 3);
    const float r = (float)luaL_checknumber(L, 4);
    float buffer[96] = {0};
    const int written = (vm && vm->host.mobs_near) ? vm->host.mobs_near(vm->host.ud, x, y, z, r, buffer, 96) : 0;
    const int count = written < 0 ? 0 : (written > 96 ? 96 : written);
    lua_createtable(L, count, 0);
    for (int i = 0; i < count; ++i) {
        lua_pushnumber(L, buffer[i]);
        lua_rawseti(L, -2, i + 1);
    }
    return 1;
}

